{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "reading-notes-6935e",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/kakaoBookSearch",
        "function": "kakaoBookSearch"
      },
      {
        "source": "/api/koreanDictSearch",
        "function": "koreanDictSearch"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
