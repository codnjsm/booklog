rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function requestId(a, b) {
      return a + '_' + b;
    }

    // 두 사람 사이에 친구 요청 문서가 있는지 (상태 무관)
    function hasRequestBetween(a, b) {
      return exists(/databases/$(database)/documents/friendRequests/$(requestId(a, b)))
          || exists(/databases/$(database)/documents/friendRequests/$(requestId(b, a)));
    }

    match /users/{userId} {
      // 본인 프로필, 또는 나와 친구 요청이 오간 상대의 프로필만 조회 가능.
      allow get: if signedIn() && (request.auth.uid == userId || hasRequestBetween(request.auth.uid, userId));

      // 목록 조회는 전면 차단. 이메일 검색은 findUserByEmail 함수가 서버에서 처리한다.
      // (허용하면 로그인한 누구나 전체 회원의 이메일을 덤프할 수 있음)
      allow list: if false;

      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/badges/{badgeId} {
      // 뱃지는 서버(정산)만 만든다. 직접 쓸 수 있으면 완주하지 않고도 달 수 있다.
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      // 푸시를 보낼 주소. 본인만 읽고 쓴다.
      //
      // users 문서 자체는 친구가 읽을 수 있지만(프로필 조회), 하위 컬렉션은 상위 규칙을
      // 물려받지 않으므로 여기서 따로 막는다. 토큰이 새 나가면 남이 그 기기로 알림을 보낼 수 있다.
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /friendRequests/{docId} {
      function isParticipant() {
        return signedIn()
            && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      }
      function uidsUnchanged() {
        return request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid;
      }

      allow read: if isParticipant();

      // 보내는 사람만 만들 수 있고, 반드시 pending 으로만 시작한다.
      // 문서 ID를 {fromUid}_{toUid} 로 강제해서 남의 이름으로 만들지 못하게 한다.
      // 이메일 인증(email_verified)까지 요구하는 이유: 남의 이메일로 가입해서 그 사람 행세로
      // 친구 요청을 보낼 수 있으면 안 된다. 구글 로그인 사용자는 항상 인증된 상태로 들어온다.
      allow create: if signedIn()
                    && request.auth.token.email_verified == true
                    && request.auth.uid == request.resource.data.fromUid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && docId == requestId(request.resource.data.fromUid, request.resource.data.toUid);

      // 수락/거절은 '받는 사람'만 할 수 있다. 이게 없으면 보낸 사람이 스스로 수락해서
      // 상대 동의 없이 서재를 열람할 수 있다.
      allow update: if signedIn()
                    && resource != null
                    && uidsUnchanged()
                    && (
                      (request.auth.uid == resource.data.toUid
                        && request.resource.data.status in ['accepted', 'rejected'])
                      // 거절당한 뒤 다시 요청하는 경우만 보낸 사람도 pending 으로 되돌릴 수 있다.
                      || (request.auth.uid == resource.data.fromUid
                        && resource.data.status == 'rejected'
                        && request.resource.data.status == 'pending')
                    );

      // 요청 취소 / 친구 끊기
      allow delete: if isParticipant();
    }

    match /reading-notes/{userId} {
      // 본인만 읽고 쓴다.
      //
      // 친구에게 문서 전체 읽기를 열어주면 비공개 책(isPrivate)과 인용구·독후감까지
      // 함께 나간다. 보안 규칙은 문서 단위로만 읽기를 제어할 수 있어서 일부 필드만
      // 가려서 내보낼 방법이 없다. 그래서 친구에게 보여줄 공개 범위는 getFriendShelf
      // 콜러블이 서버에서 골라 반환한다.
      // 배경: docs/decisions/260907-132332-friend-data-behind-callable.md
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /notifications/{userId}/items/{itemId} {
      // 알림은 서버(콜러블)만 만들고 지운다. 본인만 읽을 수 있다.
      // 남의 알림을 읽으면 누가 누구 글에 반응했는지 전부 들여다볼 수 있다.
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /recommendations/{recId} {
      // 책 권하기도 콜러블로만 만들고 읽고 처리한다.
      // 클라이언트가 직접 쓰면 남의 알림함에 권유를 꽂거나, 내 서재에 없는 책을
      // 지어내서 보낼 수 있다. 게시물과 같은 이유로 전면 차단해둔다.
      allow read, write: if false;
    }

    match /challenges/{challengeId} {
      // 챌린지도 콜러블로만 만들고 읽고 고친다.
      // 클라이언트가 직접 쓰면 남의 챌린지에 자기를 끼워 넣거나 목표를 낮출 수 있다.
      allow read, write: if false;
    }

    match /posts/{postId}/comments/{commentId} {
      // 하위 컬렉션은 상위 규칙을 물려받지 않으므로 따로 막는다.
      // 직접 쓰면 작성자를 위조할 수 있고, 직접 읽으면 친구가 아닌 글의 댓글도 보인다.
      allow read, write: if false;
    }

    match /posts/{postId} {
      // 발행(게시물)은 createPost/getFriendFeed/deletePost 콜러블을 통해서만 만들고 읽고 지운다.
      // 클라이언트가 직접 쓰면 스냅샷에 화이트리스트 밖 필드를 넣어 친구에게 그대로 노출시킬
      // 수 있어서, 규칙 없는 컬렉션의 기본 거부에 기대지 않고 명시적으로 전면 차단해둔다.
      // 배경: docs/decisions/260907-144119-post-snapshot-server-only-write.md
      allow read, write: if false;
    }
  }
}
